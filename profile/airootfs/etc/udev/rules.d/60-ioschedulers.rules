# Velaris — I/O Schedulers otimizados por tipo de disco

# NVMe — latência mínima, não precisa de escalonador
ACTION=="add|change", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="none"

# SSD SATA — mq-deadline é leve e eficiente
ACTION=="add|change", KERNEL=="sd[a-z]*|xvd[a-z]*", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="mq-deadline"

# HDD — bfq prioriza I/O do sistema sobre downloads em background
ACTION=="add|change", KERNEL=="sd[a-z]*", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}="bfq"
