QWidget {
    font-family: "Noto Sans";
    font-size: 9.5pt;
}

QPushButton {
    min-height: 34px;
    min-width: 92px;
    padding: 4px 14px;
    border-radius: 7px;
}

QComboBox {
    min-height: 32px;
    padding: 2px 38px 2px 10px;
    border: 1px solid palette(mid);
    border-radius: 10px;
    combobox-popup: 0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border-left: 1px solid palette(mid);
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}

QComboBox#languageWidget {
    min-height: 40px;
    font-size: 11pt;
}

QComboBox#languageWidget QAbstractItemView {
    min-height: 380px;
    min-width: 540px;
    padding: 6px;
    outline: 0;
}

QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 8px;
}

QListView, QTreeView {
    min-width: 280px;
    border-radius: 8px;
    padding: 6px;
}

QScrollBar:vertical {
    width: 12px;
    margin: 2px;
    background: transparent;
}

QScrollBar::handle:vertical {
    min-height: 30px;
    border-radius: 5px;
    background: palette(mid);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QGroupBox {
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
}

QProgressBar {
    min-height: 18px;
    border-radius: 7px;
    text-align: center;
}
