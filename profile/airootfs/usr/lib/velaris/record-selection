#!/usr/bin/env bash
set -euo pipefail

kind="${1:-}"
value="${2:-}"

case "${kind}:${value}" in
    kernel:bore-lto|kernel:cachyos|kernel:lts|kernel:arch|\
    graphics:nvidia-open|graphics:nouveau|graphics:amd|graphics:intel|graphics:virtual|graphics:universal|\
    profile:balanced|profile:performance|profile:powersave) ;;
    *)
        printf 'Invalid Velaris installer selection: %s=%s\n' "${kind}" "${value}" >&2
        exit 64
        ;;
esac

install -d -m 0755 /etc/velaris/installer
printf '%s\n' "${value}" > "/etc/velaris/installer/${kind}"
chmod 0644 "/etc/velaris/installer/${kind}"
